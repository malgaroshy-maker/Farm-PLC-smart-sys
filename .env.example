# ===========================================
# Algaroshy Farm — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# DO NOT commit the actual .env file.

# -------------------------------------------
# General
# -------------------------------------------
APP_ENV=development          # development | staging | production
APP_DEBUG=false              # true = log every SQL statement
FARM_TIMEZONE=Africa/Tripoli
DEFAULT_LANGUAGE=ar          # ar | en

# -------------------------------------------
# Backend API
# -------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000                # the ONE place to change the API port; run.bat/run.sh point the simulator + web at it
WEB_PORT=                    # optional; default 5173 (dev) / 4173 (demo)
API_RELOAD=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-real-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Only needed when the browser calls the API directly (not via the Vite proxy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEPLOYMENT_MODE=simulation    # simulation | local_pilot | production_hybrid

# -------------------------------------------
# Auth bootstrap (used by `python -m app.seed`)
# -------------------------------------------
ADMIN_USERNAME=admin
# Leave empty to have the seed script generate one and print it once
ADMIN_PASSWORD=
# Shared secret between the API and the simulator / PLC bridge
SIMULATOR_TOKEN=dev-simulator-token

# -------------------------------------------
# Command safety
# -------------------------------------------
MAX_CONCURRENT_ZONES=1        # dual-zone stays off until commissioning
TANK_CRITICAL_PCT=10
TANK_WARNING_PCT=25
COMMAND_TIMEOUT_SEC=15        # pending → timed_out if the controller never picks it up
COMMAND_EXECUTION_TIMEOUT_SEC=180
STATE_STALE_AFTER_SEC=5       # ALM-044 data stale
COMM_LOST_AFTER_SEC=30        # ALM-029 communication lost

# -------------------------------------------
# Alarms & telemetry history
# -------------------------------------------
ALARM_DEBOUNCE_SEC=10         # derived pressure warnings
REPEATED_FAULT_THRESHOLD=3    # ALM-036: major faults per zone per 24 h
TELEMETRY_INTERVAL_SEC=10
TELEMETRY_RETENTION_DAYS=7

# -------------------------------------------
# Database
# -------------------------------------------
# SQLite (development/simulation)
DATABASE_URL=sqlite+aiosqlite:///./farm.db

# PostgreSQL (staging/production)
# DATABASE_URL=postgresql://user:password@localhost:5432/algaroshy_farm

# -------------------------------------------
# Simulator
# -------------------------------------------
# API_URL is derived from API_PORT by the launcher; set it only when running the simulator by hand
API_URL=http://127.0.0.1:8000/api/v1
TIMESCALE=1                   # 60 = one simulated minute per real second

# -------------------------------------------
# Web app (Vite reads VITE_* from this root .env)
# -------------------------------------------
# Leave VITE_API_URL empty to use the dev proxy (recommended; works from phones on the LAN)
VITE_API_URL=
# derived from API_PORT by the launcher; set it only when running vite by hand
VITE_PROXY_TARGET=http://127.0.0.1:8000

# -------------------------------------------
# MQTT (Edge/PLC Integration — optional)
# -------------------------------------------
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# MQTT_TOPIC_PREFIX=farm/

# -------------------------------------------
# Notifications
# -------------------------------------------
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=alerts@algaroshyfarm.com
# EMAIL_PASSWORD=

# SMS_GATEWAY_URL=
# SMS_API_KEY=
# SMS_FROM_NUMBER=

# -------------------------------------------
# PLC Adapter (Phase 7+)
# -------------------------------------------
# PLC_PROTOCOL=modbus          # modbus | opcua
# PLC_HOST=192.168.1.100
# PLC_PORT=502

# -------------------------------------------
# AI Services (Milestone E)
# -------------------------------------------
# Primary Provider: APInex (OpenAI-compatible)
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_API_KEY=
APINEX_MODEL=free/deepseek-v4-pro-0813
APINEX_FALLBACK_MODEL=free/minimax-m3.1-flash

# Fallback Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI General & Resilience
AI_TIMEOUT_SEC=45.0
AI_ADVISOR_TIMEOUT_SEC=90.0
AI_MAX_RETRIES=2
AI_TOKEN_BUDGET=2048
AI_OFFLINE_FALLBACK=true
AI_DAILY_BRIEFING_TIME=06:00

# Weather API (Open-Meteo) — Algaroshy Farm (32.516250, 14.070361, Africa/Tripoli)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_LATITUDE=32.516250
WEATHER_LONGITUDE=14.070361
WEATHER_TIMEZONE=Africa/Tripoli
WEATHER_CACHE_TTL_SEC=10800

# AI Feature Toggles (true/false)
AI_ALARM_ASSISTANT_ENABLED=true
AI_SMART_SCHEDULING_ENABLED=true
AI_PREDICTIVE_MAINTENANCE_ENABLED=true
AI_ANOMALY_DETECTION_ENABLED=true
AI_WEATHER_ADVISOR_ENABLED=true
AI_WATER_OPTIMIZER_ENABLED=true
AI_DAILY_INSIGHTS_ENABLED=true
AI_CROP_VISION_ENABLED=false           # Requires camera hardware
AI_VOICE_CONTROL_ENABLED=false          # Future phase
AI_SEASONAL_LEARNING_ENABLED=false      # Requires 30+ days of data

# ── Notifications (Milestone G3) ──
# Telegram: create a bot with @BotFather, paste its token here, then on Settings -> Notifications
# send /start to the bot and press "Detect my chat". Keep the token secret.
TELEGRAM_BOT_TOKEN=
# Web push keys are generated automatically on first use; set these only to pin them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:farm-admin@localhost
