{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd apps\\api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@algaroshy/web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
