// Algaroshy Farm PLC (G5) - the whole program in one FB, called from Main (OB1) with one instance DB.

FUNCTION_BLOCK "FB_Farm"
TITLE = 'Farm program: inputs -> link -> power -> fallback -> water -> zones -> pumps -> outputs'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR
      tTick : TON_TIME;
      tickMem : Bool;                    // last scan's tick (restarts the 1 s timer)
      firstScan : Bool := TRUE;          // non-retain: TRUE again after every restart
      lastDay : USInt;
      link : "FB_Link";
      power : "FB_Power";
      fallback : "FB_Fallback";
      hyd : "FB_Hydraulics";
      zone : Array[1..16] of "FB_Zone";
      booster : "FB_Pump";
      well : "FB_Pump";
      radio : "FB_RadioBoxes";
      alarms : "FB_Alarms";
      mb : "FB_ModbusMap";
   END_VAR
   VAR_TEMP
      i : Int;
      tick : Bool;
      reset : Bool;
      useWell : Bool;
      now : DTL;
      ret : Int;
      rem : DInt;
      sel : Int;
      r : Int;
      z : Int;
      hh : Int;
      mm : Int;
      digits : String[10];
      ca : String[2];
      cb : String[2];
      cc : String[2];
      cd : String[2];
      tstr : String[5];
   END_VAR
BEGIN
   // one-cycle pulse every second
   // NOT "IN := NOT #tTick.Q": on S7-1500 reading .Q updates the timer, so it resets in the
   // same scan and the pulse is never seen (found in PLCSIM). Restart from last scan's pulse.
   #tTick(IN := NOT #tickMem, PT := T#1S);
   #tick := #tTick.Q;
   #tickMem := #tick;
   "DB_Farm".Tick1s := #tick;

   IF #firstScan THEN
      "DB_Farm".Mode := "DB_Power".SavedMode;            // off stays off across a restart
   END_IF;

   "FC_ReadInputs"();
   #link(Tick1s := #tick);
   // read the reset AFTER the command channels set it (it is cleared at the end of this scan;
   // read before, the pumps and the well lock-out never saw a reset - found in PLCSIM)
   #reset := "DB_Cmd".ResetReq;
   #power(MainsOk := "DI_MainsOk", Tick1s := #tick, FirstScan := #firstScan);
   #fallback(Active := "DB_Farm".FallbackActive, Tick1s := #tick);
   #hyd(Reset := #reset);

   FOR #i := 1 TO 16 DO
      // the source of the run in progress, or the one a start in this scan would use
      IF "DB_Zones".Zone[#i].State >= 1 AND "DB_Zones".Zone[#i].State <= 5 THEN
         #useWell := "DB_Zones".Zone[#i].UsesWell;
      ELSE
         #useWell := "DB_Farm".TankCritical AND "DB_Config".Zone[#i].UsesWellDirect;
      END_IF;
      IF #useWell THEN
         #zone[#i](ZoneIndex := #i, Tick1s := #tick,
                   Trip := #hyd.Trip[#i], TripCode := #hyd.TripCode[#i],
                   PumpRunning := "DB_Pumps".Well.RunFb,
                   PumpFailed := "DB_Pumps".Well.FailedStart OR "DB_Pumps".Well.Fault,
                   PumpFailCode := 7);
      ELSE
         #zone[#i](ZoneIndex := #i, Tick1s := #tick,
                   Trip := #hyd.Trip[#i], TripCode := #hyd.TripCode[#i],
                   PumpRunning := "DB_Pumps".Booster.RunFb,
                   PumpFailed := "DB_Pumps".Booster.FailedStart OR "DB_Pumps".Booster.Fault,
                   PumpFailCode := 6);
      END_IF;
   END_FOR;

   #booster(RunFbIn := "DI_BoosterRun", FaultIn := "DI_BoosterFault",
            HandIn := "DI_BoosterHand", OffIn := "DI_BoosterOff",
            Tick1s := #tick, Reset := #reset, PowerOk := "DB_Farm".PowerOk,
            Inhibit := "DB_Farm".EStop OR "DB_Farm".TankCritical,   // never run dry, even in HAND
            P := "DB_Pumps".Booster);
   #well(RunFbIn := "DI_WellRun", FaultIn := "DI_WellFault",
         HandIn := "DI_WellHand", OffIn := "DI_WellOff",
         Tick1s := #tick, Reset := #reset, PowerOk := "DB_Farm".PowerOk,
         Inhibit := "DB_Farm".EStop OR "DB_Farm".WellSensorBad, P := "DB_Pumps".Well);

   #radio(Tick1s := #tick);
   #alarms();
   #mb();
   "FC_WriteOutputs"();

   // midnight: daily counters
   #ret := RD_LOC_T(#now);
   IF #ret = 0 THEN
      IF #now.DAY <> #lastDay AND NOT #firstScan THEN
         FOR #i := 1 TO 16 DO
            "DB_Zones".Zone[#i].StartsToday := 0;
         END_FOR;
         "DB_Pumps".Booster.EnergyKwhToday := 0.0;
         "DB_Pumps".Well.EnergyKwhToday := 0.0;
      END_IF;
      #lastDay := #now.DAY;
   END_IF;

   // display values for the HMI: minutes left on a timed run, and the selected zone mirrored
   FOR #i := 1 TO 16 DO
      "DB_HMI".RemainingMin[#i] := 0;
      IF "DB_Zones".Zone[#i].Running AND "DB_Zones".Zone[#i].TargetSec > 0 THEN
         #rem := "DB_Zones".Zone[#i].TargetSec - "DB_Zones".Zone[#i].RuntimeSec;
         IF #rem > 0 THEN
            "DB_HMI".RemainingMin[#i] := DINT_TO_INT((#rem + 59) / 60);
         END_IF;
      END_IF;
   END_FOR;
   #sel := "DB_HMI".SelectedZone;
   IF #sel >= 1 AND #sel <= 16 THEN
      "DB_HMI".SelState := "DB_Zones".Zone[#sel].State;
      "DB_HMI".SelRunSource := "DB_Zones".Zone[#sel].RunSource;
      "DB_HMI".SelPanelMode := "DB_Zones".Zone[#sel].PanelMode;
      "DB_HMI".SelFaultCode := "DB_Zones".Zone[#sel].FaultCode;
      "DB_HMI".SelRuntimeMin := DINT_TO_INT("DB_Zones".Zone[#sel].RuntimeSec / 60);
      "DB_HMI".SelRemainingMin := "DB_HMI".RemainingMin[#sel];
      "DB_HMI".SelFlow := "DB_Zones".Zone[#sel].FlowM3h;
      "DB_HMI".SelPressure := "DB_Zones".Zone[#sel].PressureBar;
   END_IF;

   // Settings screen: apply a mode chosen on the HMI (same values as the app's set_mode)
   IF "DB_HMI".ReqMode >= 0 AND "DB_HMI".ReqMode <= 3 THEN
      "DB_Farm".Mode := "DB_HMI".ReqMode;
   END_IF;
   "DB_HMI".ReqMode := -1;
   "DB_Power".SavedMode := "DB_Farm".Mode;

   // Schedule screen: the next fallback runs as rows (zone name, HH:MM, minutes, done)
   #digits := '0123456789';
   "DB_HMI".SchedCount := "DB_Fallback".Count;
   FOR #r := 1 TO 12 DO
      "DB_HMI".SchedValid[#r] := #r <= "DB_Fallback".Count AND "DB_Fallback".Run[#r].Valid;
      IF "DB_HMI".SchedValid[#r] THEN
         #z := "DB_Fallback".Run[#r].ZoneIndex;
         IF #z >= 1 AND #z <= 16 THEN
            "DB_HMI".SchedName[#r] := "DB_HMI".ZoneName[#z];
         END_IF;
         #hh := "DB_Fallback".Run[#r].StartMinOfDay / 60;
         #mm := "DB_Fallback".Run[#r].StartMinOfDay MOD 60;
         #ca := MID(IN := #digits, L := 1, P := #hh / 10 + 1);
         #cb := MID(IN := #digits, L := 1, P := #hh MOD 10 + 1);
         #cc := MID(IN := #digits, L := 1, P := #mm / 10 + 1);
         #cd := MID(IN := #digits, L := 1, P := #mm MOD 10 + 1);
         #tstr := CONCAT(IN1 := #ca, IN2 := #cb);
         #tstr := CONCAT(IN1 := #tstr, IN2 := ':');
         #tstr := CONCAT(IN1 := #tstr, IN2 := #cc);
         #tstr := CONCAT(IN1 := #tstr, IN2 := #cd);
         "DB_HMI".SchedTime[#r] := #tstr;
         "DB_HMI".SchedDur[#r] := "DB_Fallback".Run[#r].DurationMin;
         "DB_HMI".SchedDone[#r] := "DB_Fallback".Run[#r].Done;
      ELSE
         "DB_HMI".SchedName[#r] := WSTRING#'';
         "DB_HMI".SchedTime[#r] := '';
         "DB_HMI".SchedDur[#r] := 0;
         "DB_HMI".SchedDone[#r] := FALSE;
      END_IF;
   END_FOR;
   IF "DB_Fallback".LoadedAt.YEAR > 2000 THEN
      #hh := USINT_TO_INT("DB_Fallback".LoadedAt.HOUR);
      #mm := USINT_TO_INT("DB_Fallback".LoadedAt.MINUTE);
      #ca := MID(IN := #digits, L := 1, P := #hh / 10 + 1);
      #cb := MID(IN := #digits, L := 1, P := #hh MOD 10 + 1);
      #cc := MID(IN := #digits, L := 1, P := #mm / 10 + 1);
      #cd := MID(IN := #digits, L := 1, P := #mm MOD 10 + 1);
      #tstr := CONCAT(IN1 := #ca, IN2 := #cb);
      #tstr := CONCAT(IN1 := #tstr, IN2 := ':');
      #tstr := CONCAT(IN1 := #tstr, IN2 := #cc);
      "DB_HMI".SchedLoaded := CONCAT(IN1 := #tstr, IN2 := #cd);
   ELSE
      "DB_HMI".SchedLoaded := '--:--';
   END_IF;

   CASE "DB_Farm".Mode OF
      0: "DB_Farm".ModeText := 'off';
      2: "DB_Farm".ModeText := 'manual';
      3: "DB_Farm".ModeText := 'maintenance';
   ELSE
      "DB_Farm".ModeText := 'auto';
   END_CASE;

   "DB_Cmd".ResetReq := FALSE;
   #firstScan := FALSE;
END_FUNCTION_BLOCK

DATA_BLOCK "iFarm"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_Farm"
BEGIN
END_DATA_BLOCK

ORGANIZATION_BLOCK "Main"
TITLE = 'Main Program Sweep (Cycle)'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
   "iFarm"();
END_ORGANIZATION_BLOCK
